name: Compilar Mod
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Descompactar Mod
        run: unzip Creator-Physics-NeoForge-1.21.1-Ready.zip
        
      - name: Configurar Java 21
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '21'
          
      - name: Permissao de Execucao
        run: chmod +x gradlew
        
      - name: Compilar com o Gradle
        run: ./gradlew build
        
      - name: Guardar o Mod Pronto
        uses: actions/upload-artifact@v4
        with:
          name: meu-mod-compilado
          path: build/libs/*.jar
